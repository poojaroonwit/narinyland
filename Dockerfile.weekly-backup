# A short-lived scheduled worker. Never runs the Narinyland web server.
FROM alpine:3.22
RUN apk add --no-cache bash postgresql17-client aws-cli ca-certificates
COPY scripts/weekly-database-backup.sh /usr/local/bin/weekly-database-backup
RUN chmod 755 /usr/local/bin/weekly-database-backup && bash -n /usr/local/bin/weekly-database-backup
ENV AWS_EC2_METADATA_DISABLED=true \
    PGCONNECT_TIMEOUT=10 \
    PGSSLMODE=prefer
CMD ["/usr/local/bin/weekly-database-backup"]
